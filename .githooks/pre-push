#!/bin/sh
# Pre-push: NON aggiunge più voci in automatico.
# Le voci del changelog vanno curate a mano (in linguaggio "per tutti"):
# le aggiunge Claude come ultimo step dopo ogni modifica al gameplay/leggibilità,
# oppure tu con:  npm run changelog -- "Testo leggibile" --type fix|feature|balance
#
# (L'auto-append dai messaggi di commit è stato disattivato apposta: i messaggi
#  di commit sono troppo tecnici/brevi e sporcherebbero la pagina Novità.)
echo "ℹ  Ricorda: il changelog (/updates) si aggiorna con voci curate, non dai commit."
exit 0
