{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "headers": [ {
  "source": "**/*.@(js|html)",
  "headers": [ {
    "key": "Cache-Control",
    "value": "no-cache, no-store, must-revalidate"
  } ]
}]
    }
  ]
}
