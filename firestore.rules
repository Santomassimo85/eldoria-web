rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Authenticated helper ─────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Characters ───────────────────────────────────────────────────────────
    match /characters/{uid} {
      allow read:  if isAuth();
      allow write: if isOwner(uid);
    }

    // ── World Boss chat ──────────────────────────────────────────────────────
    match /world_boss_chat/{msgId} {
      allow read:  if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ── Battle meta (World Boss turn tracker) ────────────────────────────────
    match /battle_meta/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ── Arena meta (tournament) ──────────────────────────────────────────────
    match /arena_meta/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ── Training matches ─────────────────────────────────────────────────────
    match /training_matches/{matchId} {
      allow read:  if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.challengerId == request.auth.uid ||
        resource.data.opponentId  == request.auth.uid ||
        resource.data.opponentId  == null
      );
      allow delete: if false;
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:  if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ── Arena bets ───────────────────────────────────────────────────────────
    match /bets/{betId} {
      allow read:  if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth();
      allow delete: if false;
    }

    // ── Player sprites ───────────────────────────────────────────────────────
    match /player_sprites/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }
    match /player_sprites_admin/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ── Arena market ─────────────────────────────────────────────────────────
    match /arena_market_items/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }
  }
}
