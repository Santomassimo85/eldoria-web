rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isMaster() {
      return isLoggedIn() && (
        request.auth.uid == "WNXsX7fSY5a3g2VZruYEXgFILOJ3" ||
        request.auth.token.email == "santomassimo85@gmail.com" ||
        request.auth.token.email == "ripperti96@gmail.com"
      );
    }
    // Può gestire SOLO i riassunti di sessione (collaboratore), oltre al master.
    function canEditSummaries() {
      return isMaster() || (
        isLoggedIn() &&
        request.auth.token.email == "ripperti96@gmail.com"
      );
    }

    // ── World Boss & turn tracker ────────────────────────────────────────────
    match /battle_meta/turn_tracker {
      allow read: if true; // consultabile (assistente di gioco)
      allow create, delete: if isMaster();
      allow update: if isLoggedIn() && (
        isMaster() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actedPlayers', 'phase', 'expiryDate', 'turnNumber', 'attackCounts'])
      );
    }

    match /battle_meta/{docId} {
      allow read: if true; // consultabile (assistente di gioco)
      allow write: if isLoggedIn();
    }

    // ── Tactical World Boss (battle_state/current) ───────────────────────────
    // Single live doc holding the map + units + turn order. Master sets up and
    // ends the battle; any logged-in player can update (their move/attack and
    // initiative roll during the turn loop, mirroring tcg_matches).
    match /battle_state/{docId} {
      allow read: if true; // consultabile (assistente di gioco)
      allow create, delete: if isMaster();
      allow update: if isLoggedIn();
    }

    match /world_boss_system/{docId} {
      allow read: if isLoggedIn();
      allow write: if isMaster();
    }

    match /bosses/{bossId} {
      allow read: if true;
      allow create, delete: if isMaster();
      allow update: if isLoggedIn() && (
        isMaster() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'shield'])
      );
    }

    // Reusable minion templates (WorldBossAdmin → Caserma). Read is open so every
    // client can resolve a minion's sprites/attacks during a fight; only the
    // Master can create, edit, activate or delete them.
    match /minions/{minionId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    // ── Presence (online status) ─────────────────────────────────────────────
    match /presence/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.token.email == "santomassimo85@gmail.com";
    }

    // ── Chat ─────────────────────────────────────────────────────────────────
    match /world_boss_chat/{msgId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isMaster();
    }

    // Global chat: owner can delete their own messages
    match /global_chat/{messageId} {
      allow read, create: if isLoggedIn();
      allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isMaster());
      allow update: if isMaster();
    }

    // ── Statistiche d'uso dell'assistente (Agent) ────────────────────────────
    // Contatore incrementato dal client a ogni consultazione; lettura aperta
    // (l'assistente lo legge senza autenticazione e lo mostra solo al Master).
    match /agent_stats/{docId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    // ── Diario degli agenti (Il Concilio) ────────────────────────────────────
    // Ogni agente AI scrive qui le sue azioni/ragionamenti. Lettura solo Master
    // (è un pannello di controllo). Creazione consentita a chi è loggato (es. il
    // frontend dell'Oracolo che persiste il proprio trace); l'agent server
    // (Admin SDK, es. Lo Scriba) scrive comunque bypassando le regole.
    match /agent_logs/{logId} {
      allow read: if isMaster();
      allow create: if isLoggedIn();
      allow update, delete: if isMaster();
    }
    // Contatori aggregati per agente (totale, per giorno, ultima cosa generata).
    match /agent_counters/{agentId} {
      allow read: if isMaster();
      allow write: if isLoggedIn();
    }

    // ── Coda oggetti verso Foundry ───────────────────────────────────────────
    // Il sito (Master) crea l'oggetto; la macro Foundry lo legge senza auth
    // (solo API key) e lo marca importato / lo elimina, come fa il sync attore.
    match /foundry_inbox/{docId} {
      allow read: if true;            // la macro Foundry legge la coda
      allow create: if isMaster();    // solo il Master, dal sito
      allow update, delete: if true;  // la macro marca "imported"/elimina (non autenticata)
    }

    // ── Coda NPC verso Foundry ───────────────────────────────────────────────
    // Stesso schema della coda oggetti, ma per gli Attori (NPC). Collezione
    // separata così la macro oggetti non tocca gli NPC e viceversa.
    match /foundry_npc_inbox/{docId} {
      allow read: if true;            // la macro Foundry NPC legge la coda
      allow create: if isMaster();    // solo il Master, dal sito
      allow update, delete: if true;  // la macro marca "imported"/elimina (non autenticata)
    }

    // ── Characters & sheets ──────────────────────────────────────────────────
    // Writes intentionally open because the Pet system needs to write to the
    // opponent's character doc when a battle resolves.
    match /characters/{charId} {
      allow read: if true;
      allow write: if true;
    }

    match /pg_sheets/{userId} {
      allow read, write: if isMaster() || (isLoggedIn() && request.auth.uid == userId);
    }

    // ── Arena ────────────────────────────────────────────────────────────────
    match /arena_config/{docId} {
      allow read: if isLoggedIn();
      allow write: if isMaster();
    }

    match /arena_meta/global {
      allow read: if true; // consultabile (assistente di gioco)
      allow write: if isLoggedIn();
    }

    match /arena_meta/{docId} {
      allow read: if true; // consultabile (assistente di gioco)
      allow write: if isLoggedIn();
    }

    match /characters_arena/{charId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && (request.auth.uid + "_arena" == charId || isMaster());
    }

    match /arena_bets/{betId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isMaster();
    }

    match /arena_tournament_history/{docId} {
      allow read: if true; // albo dei campioni, consultabile (assistente di gioco)
      allow create: if isLoggedIn();
      allow update, delete: if isMaster();
    }

    // Legacy / generic bets collection
    match /bets/{betId} {
      allow read:  if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth();
      allow delete: if false;
    }

    // ── Pet Arena (companion system) ─────────────────────────────────────────
    match /pet_battles/{battleId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.challenger.uid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.challenger.uid == request.auth.uid ||
        isMaster()
      );
    }

    // ── TCG (1v1 card game) ──────────────────────────────────────────────────
    // Mirrors pet_battles intent: any logged-in user can browse and play.
    // Create allows either a self-authored challenge (challenger.uid is mine)
    // OR a master-authored one (for spawning practice matches). Update is
    // open so both clients can write to the shared state during the live
    // turn loop. Delete is limited to the challenger or master.
    match /tcg_matches/{matchId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (
        isMaster() ||
        (request.resource.data.challenger != null
          && request.resource.data.challenger.uid == request.auth.uid)
      );
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        isMaster() ||
        (resource.data.challenger != null
          && resource.data.challenger.uid == request.auth.uid)
      );
    }


  match /tcg_tournament/{docId} {
    allow read: if true; // consultabile (assistente di gioco)
    allow create, delete: if isMaster();
    allow update: if isLoggedIn();
  }
    // ── Player sprites ───────────────────────────────────────────────────────
    match /player_sprites/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }
    match /player_sprites_admin/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ── Arena market ─────────────────────────────────────────────────────────
    match /arena_market_items/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ── Feedback (player reviews + master replies) ───────────────────────────
    // Deterministic doc id: `${uid}_${featureKey}`
    //   read   → Master sees all; players see only their own
    //   create → only the author, on their own deterministic doc id, stars 0..5
    //   update → author (same constraints) OR Master (to write masterReply)
    //   delete → author or Master
    match /feedback/{docId} {
      allow read: if isLoggedIn() && (
        isMaster() ||
        resource.data.authorUid == request.auth.uid
      );
      allow create: if isLoggedIn()
        && request.resource.data.authorUid == request.auth.uid
        && docId == request.auth.uid + "_" + request.resource.data.feature
        && request.resource.data.stars is number
        && request.resource.data.stars >= 0
        && request.resource.data.stars <= 5;
      allow update: if isLoggedIn() && (
        (
          request.resource.data.authorUid == request.auth.uid
          && docId == request.auth.uid + "_" + request.resource.data.feature
          && request.resource.data.stars is number
          && request.resource.data.stars >= 0
          && request.resource.data.stars <= 5
        ) || (
          isMaster()
          && request.resource.data.authorUid == resource.data.authorUid
        )
      );
      allow delete: if isLoggedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isMaster()
      );
    }

    // ── Diario di Bordo (diario collaborativo di gruppo) ─────────────────────
    //   read   → ogni loggato (il filtro per party è lato client, come dm_sessions)
    //   create → solo l'autore, sul proprio uid, con testo valido e party noto
    //   delete → l'autore o il Master
    //   update → nessuno (le voci sono immutabili)
    match /diary_notes/{docId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.party in ["AMEA", "LEAF", "ENOX", "LAC"];
      allow update: if false;
      allow delete: if isLoggedIn() && (
        resource.data.authorUid == request.auth.uid || isMaster()
      );
    }

    // ── Oracolo bendato (Tarocchi · Alaric) ──────────────────────────────────
    // Richieste di lettura + responsi. Stile permissivo come tcg_matches:
    //   read   → ogni loggato (è la cronologia condivisa tra richiedente,
    //            l'oracolo Alaric e i Master)
    //   create → solo il richiedente, sul proprio uid, stato 'pending'
    //   update → ogni loggato (l'oracolo compila il responso; il limite 1/giorno
    //            e i ruoli sono applicati lato client)
    //   delete → il richiedente o il Master
    match /oracle_readings/{readingId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.requesterUid == request.auth.uid || isMaster()
      );
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{msgId} {
      allow read: if isLoggedIn() && (resource.data.userId == request.auth.uid || isMaster());
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (resource.data.userId == request.auth.uid || isMaster());
      allow delete: if isLoggedIn() && (resource.data.userId == request.auth.uid || isMaster());
    }

    // ── Market & items ───────────────────────────────────────────────────────
    match /items/{itemId} {
      allow read: if true;
      allow create, delete: if isMaster();
      allow update: if isLoggedIn();
    }

    match /settings/market_config {
      allow read: if isLoggedIn();
      allow write: if isMaster();
    }

    // Statistiche di visita del mercato (totale + per giorno). Contatore
    // incrementato dal client a ogni visita; lettura aperta, mostrate solo al
    // Master. Stesso schema di agent_stats.
    match /market_stats/{docId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    match /settings/changelog_hidden {
      allow read: if true;
      allow write: if isMaster();
    }

    // Configurazione Oracolo (dorso globale delle carte). Lettura pubblica
    // (tutti vedono il dorso scelto); scrittura ad ogni loggato — il client
    // limita il cambio globale al solo Alaric (i Master usano un preview locale).
    match /settings/oracle {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    // ── Lo Scriba (gazzetta) ─────────────────────────────────────────────────
    // Numeri e configurazione: solo il Master li consulta/gestisce dal pannello.
    // L'agent server (Admin SDK) li scrive comunque, bypassando le regole.
    match /settings/scriba {
      allow read, write: if isMaster();
    }
    // Numeri INVIATI = archivio pubblico (leggibili da tutti). Bozze/anteprime/
    // annullati restano visibili solo al Master. Scrittura solo Master.
    match /newsletters/{id} {
      allow read: if isMaster() || resource.data.status == 'sent';
      allow write: if isMaster();
    }

    // ── Misc collections ─────────────────────────────────────────────────────
    match /geo_archive/{docId}    { allow read: if true; allow write: if isMaster(); }
    match /map_pins/{pinId}       { allow read: if true; allow write: if isMaster(); }
    match /npcs/{npcId}           { allow read: if true; allow write: if isMaster(); }
    match /sessions/{partyId}     { allow read: if true; allow write: if isMaster(); }
    match /quests/{questId} {
      allow read: if true;
      allow create, delete: if isMaster();
      allow update: if isLoggedIn();
    }
    match /session_videos/{video} { allow read: if isLoggedIn(); allow write: if isMaster(); }
    match /summaries/{summaryId} {
      allow read: if true;
      allow write: if canEditSummaries();
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
    }
    // ── Generatore Sessioni DM (privato, solo master) ───────────────────────
    // Sessioni HTML generate/archiviate — SOLO master/co-master. NON è la
    // collezione `sessions` (quella è il calendario). Isolamento per party
    // applicato lato client (ogni query filtra per `party`).
    match /dm_sessions/{docId} {
      allow read, write: if isMaster();
    }
    // Config dei party (AMEA/LEAF/ENOX): personaggi, mondo, citazione, attivo.
    match /parties/{partyId} {
      allow read, write: if isMaster();
    }

    match /messages/{msgId}       { allow create: if isLoggedIn(); allow read, write: if isMaster(); }
    match /party_tracks/{partyId} { allow read, write: if isLoggedIn(); }
    match /rolls/{rollId}         { allow read, create: if isLoggedIn(); }
  }
}
