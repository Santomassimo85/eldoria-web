{
  "name": "eldoria-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:arena-shopping": "esbuild src/data/arenaShopping.js --bundle --platform=node --format=cjs --target=node22 --outfile=functions/arenaShopping.js",
    "build:worldboss-schedule": "esbuild src/data/worldBossSchedule.js --bundle --platform=node --format=cjs --target=node22 --outfile=functions/worldBossSchedule.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "changelog": "node scripts/changelog.mjs",
    "build:pets": "esbuild src/data/petOps.js --bundle --platform=node --format=cjs --target=node22 --outfile=functions/petBundle.js --banner:js=\"// GENERATO da src/data/petOps.js con npm run build:pets: non modificare a mano.\"",
    "android:sync": "cap sync android",
    "android:apk": "cap sync android && cd android && gradlew.bat assembleRelease && cd .. && node scripts/copy-apk.mjs",
    "build:segrete": "esbuild src/data/segreteServer.js --bundle --platform=node --format=cjs --target=node22 --outfile=functions/segreteBundle.js --banner:js=\"// GENERATO da src/data/segreteServer.js con npm run build:segrete: non modificare a mano.\"",
    "build:demo": "vite build -c vite.demo.config.js && node tools/pack-demo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@google/generative-ai": "^0.24.1",
    "@vercel/analytics": "^1.5.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.5.0",
    "leaflet": "^1.9.4",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-medium-image-zoom": "^5.4.0",
    "react-quick-pinch-zoom": "^5.1.1",
    "react-router-dom": "^7.9.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.36.0",
    "@google-cloud/storage": "^7.19.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  }
}
